{
  "name": "kzi-uzi-calculator",
  "version": "4.0.0",
  "private": true,
  "description": "Калькулятор показателя защищенности Кзи и уровня зрелости Узи по методикам ФСТЭК России",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "docx": "9.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "prettier": "3.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
